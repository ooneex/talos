{
  "dependencies": {
    "@talosjs/utils": "workspace:^"
  },
  "description": "URL parsing and manipulation library with query string handling, path normalization, and route parameter extraction for web applications",
  "devDependencies": {
    "@talosjs/translation": "workspace:^",
    "@talosjs/types": "workspace:^"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "talos",
    "path",
    "query-string",
    "routing",
    "typescript",
    "uri",
    "url"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/url",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.4"
}
