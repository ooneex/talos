{
  "dependencies": {
    "@talosjs/container": "workspace:^",
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^"
  },
  "description": "Transition-based workflow engine — compose business processes from small, conditional, reversible steps with automatic rollback on failure",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "talos",
    "typescript",
    "workflow"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/workflow",
  "scripts": {
    "build": "bunup",
    "fmt": "bun fmt --no-script --staged",
    "lint": "bun check",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.11"
}
