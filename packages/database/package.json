{
  "dependencies": {
    "@talosjs/app-env": "workspace:^",
    "@talosjs/container": "workspace:^",
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^",
    "@talosjs/utils": "workspace:^"
  },
  "description": "Database layer on Bun's native SQL client — a decorator-based ORM (entities, relations, repositories, query builders, transactions) for PostgreSQL, MySQL and SQLite, plus Redis and Dragonfly clients",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "database",
    "db",
    "entity",
    "mysql",
    "orm",
    "postgres",
    "query-builder",
    "repository",
    "sql",
    "sqlite",
    "talos",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/database",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.3"
}
