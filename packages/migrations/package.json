{
  "dependencies": {
    "@talosjs/container": "workspace:^"
  },
  "description": "Database migration runner with versioned schema changes, rollback support, execution logging, and container-aware lifecycle management",
  "devDependencies": {
    "@talosjs/exception": "workspace:^"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "database",
    "migrations",
    "talos",
    "schema",
    "typescript",
    "versioning"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/migrations",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.5"
}
