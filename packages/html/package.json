    "package.json"
  ],
  "keywords": [
    "bun",
    "cheerio",
    "dom",
    "html",
    "markup",
    "talos",
    "parser",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/html",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.3"
