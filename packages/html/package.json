{
  "dependencies": {
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^"
  },
  "description": "Dependency-free HTML parsing and DOM manipulation toolkit for the browser and Bun — an HTML5 parser, CSS selector engine, and jQuery-like API to extract, transform, and query HTML content",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "browser",
    "bun",
    "css-selector",
    "dom",
    "html",
    "markup",
    "talos",
    "parser",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/html",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.0"
}
