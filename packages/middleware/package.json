{
  "dependencies": {
    "@talosjs/app-env": "workspace:^",
    "@talosjs/container": "workspace:^"
  },
  "description": "Middleware pipeline framework with decorator-based registration for processing HTTP requests, responses, and WebSocket events in sequence",
  "devDependencies": {
    "@talosjs/controller": "workspace:^",
    "@talosjs/socket": "workspace:^",
    "@talosjs/types": "workspace:^"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "decorator",
    "handler",
    "http",
    "middleware",
    "talos",
    "pipeline",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/middleware",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.3"
}
