{
  "dependencies": {
    "@linear/sdk": "^84.0.0",
    "@talosjs/app-env": "workspace:^",
    "@talosjs/container": "workspace:^",
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^"
  },
  "description": "Linear project management integration — create, update, and query issues, teams, and projects via the Linear API with dependency injection support",
  "devDependencies": {},
  "exports": {
    ".": {
      "import": {
