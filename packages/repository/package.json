{
  "dependencies": {
    "@talosjs/container": "workspace:^"
  },
  "description": "Data access layer with decorator-based repository registration, query abstraction, and dependency injection for clean persistence patterns",
  "devDependencies": {
    "@talosjs/types": "workspace:^"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "dao",
    "data-access",
    "decorator",
    "talos",
    "pattern",
    "repository",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/repository",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.3"
}
