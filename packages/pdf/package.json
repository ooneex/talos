{
  "name": "@talosjs/pdf",
  "description": "PDF content extraction toolkit that classifies PDFs and converts them to Markdown",
  "version": "1.1.2",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "test": "bun test tests",
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^"
  },
  "keywords": [
    "bun",
    "document",
    "extraction",
    "markdown",
    "talos",
    "pdf",
    "typescript"
  ]
}
