{
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@sentry/node": "^10.46.0",
    "@talosjs/app-env": "workspace:^",
    "@talosjs/container": "workspace:^"
  },
  "description": "Structured logging service with multiple output targets, log level filtering, contextual metadata, and dependency injection integration",
  "devDependencies": {
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^",
    "@talosjs/types": "workspace:^"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "debug",
    "logger",
    "logging",
    "logs",
    "talos",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/logger",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.0"
}
