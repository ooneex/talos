{
  "dependencies": {
    "@talosjs/container": "workspace:^"
  },
  "description": "Define and evaluate feature flags as injectable, named toggles with descriptions and dynamic enablement",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "feature-flag",
    "feature-flags",
    "feature-toggle",
    "talos",
    "toggle",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/feature-flag",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.3"
}
