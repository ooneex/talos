{
  "dependencies": {
    "@talosjs/exception": "workspace:^",
    "@talosjs/http-status": "workspace:^"
  },
  "description": "Dependency-free injection container — manages service lifecycle with singleton, transient, and request-scoped registrations and resolves constructor dependencies declared with @inject",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "bun",
    "container",
    "dependency-injection",
    "di",
    "ioc",
    "talos",
    "typescript"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@talosjs/container",
  "scripts": {
    "build": "bunup",
    "fmt": "bunx biome check --write",
    "lint": "tsc --noEmit && bunx biome lint",
    "test": "bun test --parallel=4 --isolate tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.4"
}
