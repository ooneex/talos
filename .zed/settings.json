{
  "formatter": {
    "external": {
      "command": "bun",
      "arguments": ["fmt", "--no-script", "--stdin-filepath", "{buffer_path}"]
    }
  },
  "format_on_save": "on",
  "lsp": {
    "typescript-language-server": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    }
  }
}
